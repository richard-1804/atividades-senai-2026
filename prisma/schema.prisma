generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model users {
  id_user_pk Int       @id @default(autoincrement())
  email      String    @unique(map: "email") @db.VarChar(150)
  password   String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.DateTime(0)
  task       task[]
}

model task {
  id_task_pk  Int       @id @default(autoincrement())
  title       String    @db.VarChar(150)
  description String?   @db.Text
  status      Boolean?
  user_fk     Int?
  created_at  DateTime? @default(now()) @db.DateTime(0)
  users       users?    @relation(fields: [user_fk], references: [id_user_pk], onDelete: Cascade, onUpdate: NoAction, map: "task_ibfk_1")

  @@index([user_fk], map: "user_fk")
}

